{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/post/layout,_N_T_/post/new/layout,_N_T_/post/new/page,_N_T_/post/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/post/new/__PAGE__",
    "/post/new",
    "/post",
    "/_index",
    "/_head"
  ]
}